{
  "name": "publium-api",
  "version": "0.1.0",
  "private": true,
  "description": "Publium backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && node scripts/clean-dist.mjs && tsc",
    "test": "npm run test:lib && npm run test:moderator && npm run test:community-manager",
    "test:lib": "tsx --test src/lib/*.test.ts",
    "test:moderator": "tsx --test src/moderator/*.test.ts",
    "test:community-manager": "tsx --test src/communityManager/*.test.ts",
    "start": "node dist/index.js",
    "test:security": "npm run build && node scripts/security-smoke.mjs",
    "set-webhook": "node scripts/set-webhook.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "set-moderator-webhook": "node scripts/set-moderator-webhook.mjs",
    "set-community-manager-webhook": "node scripts/set-community-manager-webhook.mjs",
    "test:moderator:postgres": "node scripts/moderator-integration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@openai/agents": "^0.14.0",
    "@prisma/client": "^5.22.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/sharp": "^0.31.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.60.0",
    "prisma": "^5.22.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "telegram": "^2.26.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
