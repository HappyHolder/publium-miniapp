  createdAt DateTime @default(now())
  @@index([ownerUserId])
}
model PaymentOrder {
  id String @id @default(uuid())
  userId String
  kind String
  productId String
  amountTon Float
  receivingWallet String
  createdAt DateTime @default(now())
  expiresAt DateTime
  paidAt DateTime?
  @@index([userId, createdAt])
}
model PaymentLedger {
  txHash String @id
  orderId String? @unique
  userId String
  kind String
  createdAt DateTime @default(now())
}
// Incoming notifications for already-issued historical invoices; no new Stars sales.
model LegacyPaymentNotice {
  chargeId String @id
  payload Json
  createdAt DateTime @default(now())
}
// Kept independently from the five-hour editable post retention window.
model PublicationRecord {
  postId String @id
  channelId String
  userId String
  status String
  startedAt DateTime @default(now())
  publishedAt DateTime?
  tgChatId String?
  tgMessageId Int?
  error String?
  @@index([userId, channelId, publishedAt])
}
