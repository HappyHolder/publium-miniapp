generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SourceType {
  URL
  TEXT
  PROMPT
  FORWARDED_POST
  VIDEO
  AUDIO
  PDF
}

enum PostStatus {
  NEW
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PlanTier {
  FREE
  STARTER
  CREATOR
  STUDIO_PRO
}


// Lifecycle of an AI content-manager plan (a whole series of posts).
// DRAFT      = built by the planner, awaiting the user's «Приступить».
// GENERATING = worker is running items sequentially.
// SCHEDULED  = all items processed, posts sit in Отложка.
// FAILED     = worker aborted; CANCELLED = user cancelled.
enum ContentPlanStatus {
  DRAFT
  GENERATING
  SCHEDULED
  FAILED
  CANCELLED
}

// Per-item progress within a ContentPlan. A failed item becomes SKIPPED and the
// plan continues with the next one.
enum PlanItemStatus {
  PENDING
  RESEARCHING
  GENERATING
  DONE
  FAILED
  SKIPPED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id              String  @id @default(cuid())
  email           String? @unique
  name            String?
  telegramId      String? @unique
  activeChannelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels                    Channel[]
  chats                       Chat[]
  sourceInputs                SourceInput[]
  generationJobs              GenerationJob[]
  subscription                Subscription?
  aiModeratorEntitlement      AiModeratorEntitlement?
  managedModeratorBots        ManagedModeratorBot[]
  managedCommunityManagerBots ManagedCommunityManagerBot[]
  chatMessages                ChatMessage[]
  chatSessions                ChatSession[]
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  channelId String?
  title     String        @default("Новый чат")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String  @id @default(cuid())
  userId    String
  sessionId String?
  role      String // 'user' | 'assistant'
  content   String

  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model Channel {
  id       String  @id @default(cuid())
  name     String
  handle   String? @unique
  // CHANNEL is a publication destination; CHAT is a standalone Telegram group
  // backed by the same ownership root so community products can work without a channel.
  kind     String  @default("CHANNEL")
  // Stable numeric Telegram chat id (e.g. "-1001234567890"). Survives channel
  // renames — publishing prefers it over @handle so a rename never breaks it.
  tgChatId String?
  // Last successful getChatMemberCount result. Meaning depends on kind:
  // subscribers for CHANNEL, members for CHAT. Null means not measured yet.
  telegramMemberCount Int?
  memberCountUpdatedAt DateTime?
  userId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandKit       BrandKit?
  generatedPosts GeneratedPost[]
  projectDocs    ProjectDoc[]
  contentPlans   ContentPlan[]
  community      Community?
  chatLinks       ChannelChatLink[]

  @@index([userId])
  @@index([userId, kind])
}

// A Telegram group/supergroup is an independent owner resource. It may exist
// without any publication channel and owns the Publium Community products.
model Chat {
  id                   String   @id @default(cuid())
  tgChatId             String   @unique
  title                String
  username             String?
  type                 String   @default("supergroup")
  telegramMemberCount  Int?
  memberCountUpdatedAt DateTime?
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  style        ChatStyle?
  community    Community?
  channelLinks ChannelChatLink[]

  @@index([userId])
  @@index([userId, createdAt])
}

// Chat context is deliberately separate from a channel BrandKit. Community
// products can copy from a linked channel explicitly, but never share storage.
model ChatStyle {
  id           String   @id @default(cuid())
  chatId       String   @unique
  channelAbout Json?
  voiceProfile Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// Optional relationship. Neither side depends on the other for existence.
model ChannelChatLink {
  id           String   @id @default(cuid())
  channelId    String
  chatId       String
  relationType String   @default("MANUAL")
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([channelId, chatId])
  @@index([chatId])
  @@index([channelId, isPrimary])
}

// ─── BrandKit ─────────────────────────────────────────────────────────────────
// All Channel Style sub-sections are stored as Json blobs, one column per section.
//
// Why Json and not typed columns/enums:
//   - BrandKit is always fetched and written as a whole document per channel.
//   - Individual sub-fields (tone, emoji settings, colors, etc.) are never
//     filtered or indexed independently.
//   - Avoids 10+ Prisma enums that each require a migration on every UX change.
//   - Matches the frontend BrandKit shape directly — no translation layer needed.
//
// Why LinkKit was folded in (no longer a separate table):
//   - The old LinkKit model was a separate table with a single `links Json` column.
//   - That added a required join on every BrandKit fetch with no queryability gain.
//   - It is now `linkKit Json?` here, consistent with every other sub-section.
//

model BrandKit {
  id        String @id @default(cuid())
  channelId String @unique

  // Channel Style v2 sections — shape defined by frontend BrandKit interface
  channelAbout Json? // { topic, targetAudience, contentGoal }
  voiceProfile Json? // { language, addressStyle, authorRole, tone, postLength, examplePosts[], favoriteWords[], forbiddenWords[] }
  linkKit      Json? // { links: LinkItem[] }
  visualKit    Json? // { logoUrl, primaryColor, bannerTemplate, secondaryColor, aspectRatio, textOnCover, logoUsage, references[], avoidList[], ... }
  signature    Json? // { text, cta?, usage }
  postRules    Json? // { defaultStructure, neverCopySource, avoidClickbait, paragraphStyle, listUsage, ctaUsage, thingsToAvoid[], ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model SourceInput {
  id       String     @id @default(cuid())
  userId   String
  type     SourceType
  content  String
  url      String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs GenerationJob[]

  @@index([userId])
}

model GenerationJob {
  id            String    @id @default(cuid())
  userId        String
  sourceInputId String
  status        JobStatus @default(PENDING)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceInput    SourceInput     @relation(fields: [sourceInputId], references: [id], onDelete: Cascade)
  generatedPosts GeneratedPost[]

  @@index([userId])
  @@index([status])
}

model GeneratedPost {
  id              String     @id @default(cuid())
  title           String
  channelId       String
  jobId           String?
  status          PostStatus @default(NEW)
  scheduledAt     DateTime?
  publishState    String @default("IDLE")
  publishedAt     DateTime?
  tgChatId        String? // chat id of the published channel message — enables edit-in-place
  tgMessageId     Int? // message id of the published channel message (5-hour re-publish window)
  textRegensUsed  Int        @default(0)
  imageRegensUsed Int        @default(0)

  // Fields present in frontend GeneratedPost type, missing from original scaffold
  sourceType        String? // mirrors SourceType enum values as string for flexibility
  sourceUrl         String?
  sourceSummary     String?
  imagePrompt       String? // original image generation prompt — reused on regenerate-visual
  coverBaseUrl      String? // clean (text-free) cover background — lets the headline be re-rendered without regenerating the picture
  coverMode         String? // actual engine used for this post: ai | html | ai_html
  coverAspectRatio  String? // actual cover ratio used for this post: 1:1 | 16:9 | 4:5 | 9:16
  rubricId          String? // chosen rubric id (from visualKit.rubrics); null = legacy / no rubric
  rubricName        String? // denormalized rubric name — shown on the post chip without a join
  linkButtons       Json? // LinkItem[]
  selectedVariantId String?
  editorMode        String @default("RICH") // RICH = block composer for every variant; LEGACY = old text editor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel  Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  job      GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  variants PostVariant[]

  @@index([channelId])
  @@index([status])
  @@index([scheduledAt])
  @@index([jobId])
}

model PostVariant {
  id              String  @id @default(cuid())
  generatedPostId String
  label           String? // matches frontend PostVariant.label
  variantIndex    Int     @default(0)
  text            String
  bannerUrl       String?
  isSelected      Boolean @default(false)
  // Structured formatted-post layout (PostBlock[] — see server/src/lib/richPost.ts).
  // null = legacy plain post (publish falls back to text + banner).
  blocks          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedPost GeneratedPost @relation(fields: [generatedPostId], references: [id], onDelete: Cascade)

  @@index([generatedPostId])
}

model TonPayment {
  id        String   @id @default(cuid())
  txHash    String   @unique // TON transaction hash — prevents double-credit
  userId    String
  tier      PlanTier
  amountTon Float
  createdAt DateTime @default(now())

  @@index([userId])
}

model StarsPayment {
  id          String   @id @default(cuid())
  chargeId    String   @unique // telegram_payment_charge_id — prevents double-credit on duplicate webhook delivery
  userId      String
  tier        PlanTier
  amountStars Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique // stored uppercased; matched case-insensitively in app
  tier         PlanTier // tier granted on redemption
  durationDays Int // days of access the grant lasts
  redeemedAt   DateTime? // null = unused; set = burned (single-use)
  redeemedById String? // userId that redeemed it
  createdById  String? // admin telegramId that created it (audit)

  createdAt DateTime @default(now())

  @@index([code])
}

model Subscription {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  tier                        PlanTier @default(FREE)
  textGenerationsUsed         Int      @default(0)
  visualGenerationsUsed       Int      @default(0)
  bonusVisualGenerations      Int      @default(0)
  assistantMessagesUsed       Int      @default(0)
  contentManagerPostsUsed     Int      @default(0)
  communityManagerActionsUsed Int      @default(0)
  quotaResetAt                DateTime?
  expiresAt                   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiModeratorEntitlement {
  id                  String    @id @default(cuid())
  userId              String    @unique
  status              String    @default("TRIAL")
  monthlyChecksLimit  Int       @default(5000)
  checksUsed          Int       @default(0)
  inputTokensUsed     Int       @default(0)
  outputTokensUsed    Int       @default(0)
  estimatedCostMicros Int       @default(0)
  quotaResetAt        DateTime?
  trialEndsAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModeratorConversationMessage {
  id                String    @id @default(cuid())
  communityId       String
  tgUserId          String
  username          String?
  displayName       String?
  telegramMessageId Int
  text              String
  replyToMessageId  Int?
  threadKey         String    @default("main")
  moderated         Boolean   @default(false)
  moderationSignal  Json?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  community         Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, telegramMessageId])
  @@index([communityId, createdAt])
  @@index([expiresAt])
}

model ModeratorConversationEpisode {
  id               String    @id @default(cuid())
  communityId      String
  episodeKey       String
  threadKey        String    @default("main")
  category         String
  state            String    @default("OBSERVING")
  severity         String    @default("low")
  riskScore        Float     @default(0)
  summary          String    @default("")
  participantIds   Json      @default("[]")
  targetIds        Json      @default("[]")
  lastMessageId    Int?
  lastAnalyzedAt   DateTime?
  lastIntervenedAt DateTime?
  resolvedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  community        Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, episodeKey])
  @@index([communityId, state, updatedAt])
  @@index([expiresAt])
}

model ModeratorParticipantRisk {
  id            String                          @id @default(cuid())
  communityId   String
  tgUserId      String
  score         Float                           @default(0)
  level         String                          @default("low")
  evidenceCount Int                             @default(0)
  lastEventAt   DateTime
  expiresAt     DateTime
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt
  community     Community                       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  events        ModeratorParticipantRiskEvent[]

  @@unique([communityId, tgUserId])
  @@index([communityId, score])
  @@index([expiresAt])
}

model ModeratorParticipantRiskEvent {
  id          String                   @id @default(cuid())
  communityId String
  riskId      String
  episodeId   String?
  category    String
  severity    String
  delta       Float
  evidence    String
  createdAt   DateTime                 @default(now())
  community   Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  risk        ModeratorParticipantRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([riskId, createdAt])
}

model ModeratorConversationState {
  id                    String    @id @default(cuid())
  communityId           String    @unique
  stage                 String    @default("NORMAL")
  messagesSinceAnalysis Int       @default(0)
  lastAnalyzedMessageId Int?
  lastInterventionAt    DateTime?
  hourWindowStartedAt   DateTime?
  interventionsInWindow Int       @default(0)
  lastCategory          String?
  lastParticipants      Json?
  joinWindowStartedAt   DateTime?
  joinsInWindow         Int       @default(0)
  raidModeUntil         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  community             Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

// ─── Styles market ──────────────────────────────────────────────────────────────
// A Style is a ready-made cover-style PACK curated by us. The user buys (or gets
// for free) a style and "applies" it to a channel — the engine then pours the
// channel's brand + content into the style's templates. One style can bundle
// several HTML templates (e.g. the "Crypto" pack = 9 templates, one per rubric).
//
// Why Json for palette/templates: they mirror the frontend VisualKit shapes
// (BrandColor[], HtmlTemplateItem[]) and are always read/written as a whole —
// no per-field querying needed. Catalog is small, so no indexing concerns.

model Style {
  id   String @id @default(cuid())
  slug String @unique // stable human key, e.g. "crypto", "dither-ascii"

  nameRu String
  nameEn String
  descRu String   @default("")
  descEn String   @default("")
  tags   String[] @default([])

  // Pricing — FREE styles skip the purchase flow entirely.
  priceKind  String @default("FREE") // "FREE" | "PAID"
  priceStars Int? // Telegram Stars (when PAID)
  priceGram  Float? // Gram / TON amount (when PAID)

  // Applied into the channel's VisualKit on "Apply".
  brandAdaptive    Boolean @default(true) // true = pull channel color; false = fixed palette
  recommendedMode  String  @default("html") // "html" | "ai" | "ai_html"
  palette          Json    @default("[]") // BrandColor[]
  visualCoverStyle String  @default("") // master AI cover-style text
  bgStyle          String? // CoverBgStyle
  bgDetail         String? // CoverBgDetail
  fontPreset       String? // VisualKit.visualFontPreset
  logoUsage        String? // LogoUsage
  templates        Json    @default("[]") // HtmlTemplateItem[] { name, url }
  carouselTemplate Json? // one universal carousel-slide template { name, url, demoSlots } — separate from rubric templates

  // Static demo previews, pre-rendered with a demo brand.
  previews    String[] @default([])
  heroPreview String?

  published    Boolean @default(false)
  // Showcase-only: visible in the market to EVERYONE, but only an admin can
  // apply it. Used for the internal Publium / Stepan Logos packs — a shop
  // window so users see what the packs look like without being able to use them.
  showcaseOnly Boolean @default(false)
  sortOrder    Int     @default(0)
  createdBy    String? // admin telegramId that created it (audit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases StylePurchase[]

  @@index([published, sortOrder])
}

model StylePurchase {
  id        String   @id @default(cuid())
  userId    String
  styleId   String
  via       String // "STARS" | "GRAM" | "FREE" | "ADMIN"
  txHash    String?  @unique // TON tx hash — guards against reusing one deposit for several styles
  createdAt DateTime @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([userId, styleId]) // one ownership row per user/style
  @@index([userId])
}

// ─── AI Content manager ───────────────────────────────────────────────────────
// The content manager lets the assistant generate a whole SERIES of posts and
// drop them into Отложка. A ProjectDoc is uploaded knowledge (whitepaper, deck)
// the planner can base a series on; a ContentPlan is one series; a
// ContentPlanItem is one post-to-be within it. See docs/content-manager-plan.md.

// Uploaded project material attached to a channel's knowledge base. `text` holds
// the extracted plain text (pdf-parse / mammoth), capped ~200k chars; the raw
// file is not stored.
model ProjectDoc {
  id        String   @id @default(cuid())
  channelId String
  name      String
  mime      String
  sizeBytes Int
  text      String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

// Knowledge attached to one operational AI role. Unlike ProjectDoc, these
// documents do not leak across CM, Moderator and individual personas.
model RoleKnowledgeDoc {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  ownerUserId String
  name        String
  mime        String
  sizeBytes   Int
  text        String
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([ownerUserId])
}

// One content series. `source` = 'web' | 'uploads' | 'both'. Items are generated
// strictly sequentially by contentWorker; on completion posts sit SCHEDULED.
model ContentPlan {
  id           String            @id @default(cuid())
  channelId    String
  topic        String
  postsPerDay  Int
  days         Int
  startDate    DateTime
  source       String            @default("web") // 'web' | 'uploads' | 'both'
  status       ContentPlanStatus @default(DRAFT)
  generateVisuals Boolean          @default(true)
  leaseUntil DateTime?
  leaseOwner String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items   ContentPlanItem[]

  @@index([channelId])
  @@index([status])
}

// One planned post within a ContentPlan. Carries the pre-chosen rubric so the
// worker skips classification, and links to the GeneratedPost it produced.
model ContentPlanItem {
  id              String         @id @default(cuid())
  planId          String
  orderIndex      Int
  scheduledAt     DateTime
  rubricId        String?
  rubricName      String?
  workingTitle    String
  angle           String
  searchQuery     String
  status          PlanItemStatus @default(PENDING)
  contentReserved Boolean @default(false)
  visualReserved Boolean @default(false)
  quotaPeriod DateTime?
  generatedPostId String?
  errorMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// ─── Community & Moderator v1 foundation ────────────────────────────────────
model ModeratorChat {
  id            String     @id @default(cuid())
  tgChatId      String     @unique
  title         String
  username      String?
  type          String
  botStatus     String
  grantedRights Json?
  addedByTgId   String?
  lastUpdateId  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  community     Community?

  @@index([addedByTgId])
}

model Community {
  id                         String                         @id @default(cuid())
  // Legacy optional publication-channel link. New community ownership is Chat.
  channelId                  String?                        @unique
  chatId                     String?                        @unique
  moderatorChatId            String?                        @unique
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  channel                    Channel?                       @relation(fields: [channelId], references: [id], onDelete: SetNull)
  chat                       Chat?                          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  moderatorChat              ModeratorChat?                 @relation(fields: [moderatorChatId], references: [id], onDelete: SetNull)
  moderator                  Moderator?
  members                    CommunityMember[]
  warnings                   ModerationWarning[]
  events                     ModerationEvent[]
  scheduledActions           ScheduledModerationAction[]
  messageSamples             ModerationMessageSample[]
  conversationMessages       ModeratorConversationMessage[]
  conversationState          ModeratorConversationState?
  conversationEpisodes       ModeratorConversationEpisode[]
  participantRisks           ModeratorParticipantRisk[]
  participantRiskEvents      ModeratorParticipantRiskEvent[]
  managedBot                 ManagedModeratorBot?
  managedCommunityManagerBot ManagedCommunityManagerBot?
  communityManager           CommunityManager?
  personas                   Persona[]
  dailyParticipants          CommunityDailyParticipant[]
  pulseParticipants          CommunityPulseParticipant[]
  dailyStats                 CommunityDailyStat[]
}

// ─── Pulse: community analytics ────────────────────────────────────────────────
// Two layers. LAYER 1 (CommunityDailyParticipant) is the fact table: one row per
// person per day. Period metrics that are NOT additive — unique actives, DAU/MAU,
// cohorts, Orbit tiers, concentration — can only be computed correctly from it
// (summing daily uniques double-counts), and it lets us RECOMPUTE any metric
// retroactively when a formula changes. LAYER 2 (CommunityDailyStat) is the
// pre-aggregated day row that powers fast charts. Days are MSK ('YYYY-MM-DD')
// so month/quarter/year boundaries never drift.

model CommunityDailyParticipant {
  id          String   @id @default(cuid())
  communityId String
  tgUserId    String
  day         String // 'YYYY-MM-DD', Europe/Moscow
  messages    Int      @default(0)
  replies     Int      @default(0)
  firstDay    Boolean  @default(false) // first day this person ever spoke here
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, tgUserId, day])
  @@index([communityId, day])
  @@index([communityId, tgUserId])
}

// Latest public Telegram identity known to Pulse. Kept separately from daily
// facts so usernames can change without rewriting historical analytics.
model CommunityPulseParticipant {
  id          String   @id @default(cuid())
  communityId String
  tgUserId    String
  username    String?
  displayName String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, tgUserId])
  @@index([communityId, username])
}

// One row per counted message. Three independent sources can see the same
// message (moderator webhook, CM webhook, GramJS personas) — whichever gets
// there first inserts the claim and counts it; the others hit the unique
// constraint and skip, so a message is never counted twice. Rows are purged
// after a few hours by the scheduler.
model PulseMessageClaim {
  id                String   @id @default(cuid())
  communityId       String
  telegramMessageId Int
  createdAt         DateTime @default(now())

  @@unique([communityId, telegramMessageId])
  @@index([createdAt])
}

model CommunityDailyStat {
