// ─── Community Core: autonomous AI personalities on owner's Telegram accounts ──
// A Persona is a real Telegram user account, connected once via phone login, that
// lives in the channel's discussion group as a believable human. Fully isolated
// from Moderator and Community Manager: separate module, tables and runtime.

model Persona {
  id                 String    @id @default(cuid())
  communityId        String
  ownerUserId        String
  // Encrypted GramJS string session (AES-GCM, community-bound AAD). Never leaves backend.
  sessionCipher      String?
  sessionIv          String?
  sessionTag         String?
  sessionKeyVersion  Int       @default(1)
  // Public Telegram identity of the connected account.
  tgUserId           String?
  username           String?
  phone              String?
  // Transient login state (phone→code→password), not persisted after success.
  loginPhoneCodeHash String?
  loginTempSession   String?
  loginExpiresAt     DateTime?
  // Personality config (draft = editable, published = what the runtime uses).
  draftConfig        Json
  publishedConfig    Json?
  // The persona's own evolving inner mood (valence/energy/stress/... with inertia).
  personalState      Json?
  // Rolling conversation memory: summary, active topics, episodes, notes.
  conversationMemory Json?
  // Lifecycle.
  status             String    @default("DRAFT") // DRAFT | CONNECTED | ACTIVE | PAUSED | ERROR
  enabled            Boolean   @default(false)
  lastError          String?
  lastActionAt       DateTime?
  lastHealthyAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  community    Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actions      PersonaAction[]
  memory       PersonaMemory[]
  participants PersonaParticipant[]

  @@index([communityId])
  @@index([ownerUserId])
  @@index([status, enabled])
}

// What a persona knows and feels about each person it has talked with. Mirrors
// the Community Manager's participant memory, per persona.
model PersonaParticipant {
  id                String    @id @default(cuid())
  personaId         String
  tgUserId          String
  username          String?
  firstName         String?
  lastName          String?
  displayName       String
  relationship      String    @default("NEW") // NEW | ACTIVE | REGULAR | FRIEND
  relationshipState Json? // familiarity/trust/closeness/respect/tension/...
  notes             Json? // short freeform things the persona knows about them
  messageCount      Int       @default(0)
  exchangeCount     Int       @default(0)
  activeDayKeys     Json?
  lastSeenAt        DateTime  @default(now())
  lastExchangeAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, tgUserId])
  @@index([personaId, relationship, lastSeenAt])
}

model PersonaAction {
  id              String   @id @default(cuid())
  personaId       String
  decision        String // REPLY | REACT | REACT_REPLY | SILENT | ERROR
  intent          String?
  reason          String?
  response        String?
  reaction        String?
  targetMessageId Int?
  sentMessageId   Int?
  model           String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  latencyMs       Int      @default(0)
  status          String   @default("COMPLETED")
  error           String?
  createdAt       DateTime @default(now())

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId, createdAt])
}

// Append-only observation/reflection stream per persona (Smallville-style memory).
model PersonaMemory {
  id         String   @id @default(cuid())
  personaId  String
  kind       String   @default("observation") // observation | reflection
  text       String
  importance Int      @default(1)
  createdAt  DateTime @default(now())

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId, createdAt])
}

// Atomic claim so two personas never answer the same message simultaneously.
model PersonaMessageClaim {
  id                String   @id @default(cuid())
  communityId       String
  telegramMessageId Int
  personaId         String
  createdAt         DateTime @default(now())

  @@unique([communityId, telegramMessageId])
  @@index([createdAt])
}

