DATABASE_URL=""
DIRECT_URL=""
PORT=8787
NODE_ENV=development

# Local filesystem storage (replaces Vercel Blob).
# STORAGE_DIR: where files are written. PUBLIC_BASE_URL: public origin they are
# served from (used to build URLs saved in the DB and sent to Telegram).
# In production these are set by docker-compose (/data/uploads + https://<domain>).
STORAGE_DIR="./uploads"
PUBLIC_BASE_URL="http://localhost:8787"
TELEGRAM_BOT_TOKEN=""
# Must match the value set on Render, or the backend rejects webhooks with 401.
TELEGRAM_WEBHOOK_SECRET=""
# Public webhook URL set on Telegram. Used by `npm run set-webhook`.
WEBHOOK_URL="https://publium.ru/api/bot/webhook"

# Separate executor bot for Community Moderator.
MODERATOR_BOT_TOKEN=""
MODERATOR_WEBHOOK_SECRET=""
MODERATOR_BOT_USERNAME="publium_moder_bot"
COMMUNITY_MANAGER_BOT_TOKEN=""
COMMUNITY_MANAGER_WEBHOOK_SECRET=""
COMMUNITY_MANAGER_BOT_USERNAME="publium_community_bot"

# Comma-separated Telegram numeric IDs allowed into the admin panel (promo codes)
ADMIN_TELEGRAM_IDS=""

# Optional: Mini App URL for the /start "Open app" button (leave blank to omit)
MINI_APP_URL=""

# TON payments: receiving wallet (public) + TON Center API key (secret)
TON_RECEIVING_WALLET=""
TONCENTER_API_KEY=""

# Web search for the AI assistant (Tavily). Leave blank to disable search.
TAVILY_API_KEY=""

MANAGED_BOT_ENCRYPTION_KEY=

# Required for text, assistant, vision, transcription and ordinary cover generation.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_PROVIDER=replicate
COVER_ENGINE=template
# Optional: wide panoramas only.
REPLICATE_API_TOKEN=
SERPER_API_KEY=
# Optional: Community Core accounts. Both values are required for that feature.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
