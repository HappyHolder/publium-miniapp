# Publium edge — automatic HTTPS, security headers, SPA and API proxy.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src https:; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; form-action 'self'"
		-X-Powered-By
	}

	# Backend API. The edge rejects oversized bodies before they reach Node/multer.
	handle /api/* {
		request_body {
			max_size 32MB
		}
		reverse_proxy api:8787
	}

	# Templates are read from storage by the renderer, never distributed as public assets.
	@templates path_regexp templates (?i)^/uploads/.*\.(html?|xhtml)$
	handle @templates {
		respond "Not found" 404
	}

	# Uploaded & generated files (covers, logos, templates).
	handle /uploads/* {
		root * /srv
		# Active formats are downloads/plain text and cannot execute in the app origin.
		@active path *.html *.htm *.xhtml *.svg
		header @active Content-Type "text/plain; charset=utf-8"
		header @active Content-Disposition attachment
		header @active X-Content-Type-Options nosniff
		file_server
	}

	# SPA: serve the static build, fall back to index.html for client-side routes.
	handle {
		root * /srv
		# Telegram WebView aggressively keeps the previous SPA. Revalidate on every open;
		# hashed assets still return 304 when unchanged.
		header Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
